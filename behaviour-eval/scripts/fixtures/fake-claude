#!/usr/bin/env python3
"""Fixture `claude -p --output-format stream-json` for driven L3 seats: one step per
turn over FAKE_STEPS items, then UNVRS-RESULT. State per session in FAKE_CPU_DIR."""
import json, os, sys, time, uuid
from pathlib import Path
args = sys.argv[1:]
session = args[args.index("--resume") + 1] if "--resume" in args else str(uuid.uuid4())
prompt = sys.stdin.read()
state_dir = Path(os.environ.get("FAKE_CPU_DIR", "/tmp")); state_dir.mkdir(parents=True, exist_ok=True)
sf = state_dir / f"{session}.json"
st = json.loads(sf.read_text()) if sf.exists() else {"step": 0, "prompts": []}
st["prompts"].append(prompt)
steps = os.environ.get("FAKE_STEPS", "a,b,c").split(",")
# A handed-off receiver starts where the package says: skip items listed as done.
if st["step"] == 0 and "HANDED OFF" in prompt:
    st["step"] = sum(1 for s in steps if f"item {s} done" in prompt)
time.sleep(float(os.environ.get("FAKE_DELAY", "0.3")))
i = st["step"]
tools = []
if i < len(steps):
    tools = [{"type": "tool_use", "name": "Bash", "input": {"command": f"process {steps[i]}"}}]
    st["step"] += 1
done = [f"- [d{k}] item {steps[k]} done" for k in range(st["step"])]
finished = st["step"] >= len(steps)
cur = steps[i] if i < len(steps) else "summary"
nxt = "item " + steps[st["step"]] if not finished else "finish"
lines = [f"did item {cur}", "UNVRS-PROGRESS", f"now: item {cur}", f"next: {nxt}", "open:"]
lines += [] if finished else [f"- [o1] items left: {','.join(steps[st['step']:])}"]
lines += ["done:"] + done + (["- [o1] items left: none"] if finished else []) + ["END-PROGRESS"]
text = "\n".join(lines) + "\n"
if i >= len(steps):
    text += "UNVRS-RESULT: processed " + ",".join(steps)
sf.write_text(json.dumps(st))
out = [{"type": "system", "subtype": "init", "session_id": session},
       {"type": "assistant", "message": {"content": [*tools, {"type": "text", "text": text}]}},
       {"type": "result", "result": text, "session_id": session, "is_error": False}]
for o in out:
    print(json.dumps(o), flush=True)
