#!/usr/bin/env bash
# M2 smoke: every good mission fixture admits and lists as admitted; every bad one is
# refused with a nonzero exit and a message naming the missing section. Run from repo root.
set -euo pipefail

FIXTURES=behaviour-eval/fixtures/missions
JOURNAL=behaviour-eval/journals/mission-admit-smoke.log
REGISTRY=$(mktemp -d)/missions.json
FAILS=0

mkdir -p "$(dirname "$JOURNAL")"
: >"$JOURNAL"

check() { # check <name> <pass|fail> <detail>
  printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$2" "$1: $3" >>"$JOURNAL"
  if [ "$2" = PASS ]; then
    printf 'PASS %s\n' "$1"
  else
    printf 'FAIL %s — %s\n' "$1" "$3"
    FAILS=$((FAILS + 1))
  fi
}

if [ -z "${UNVRS_BIN:-}" ]; then
  cargo build -q -p unvrs
  UNVRS_BIN=target/debug/unvrs
fi
[ -x "$UNVRS_BIN" ] || { echo "FAIL missing binary $UNVRS_BIN"; exit 1; }

for name in coding-tdd bugfix no-skill-needed interactive-grill; do
  if out=$("$UNVRS_BIN" mission admit "$FIXTURES/$name.md" --registry "$REGISTRY" 2>&1); then
    id=$(printf '%s\n' "$out" | sed -n 's/^admitted: //p')
    if [ -n "$id" ]; then
      check "admit-$name" PASS "$id"
    else
      check "admit-$name" FAIL "no admitted id in output: $out"
    fi
  else
    check "admit-$name" FAIL "$out"
  fi
done

listing=$("$UNVRS_BIN" mission list --registry "$REGISTRY" 2>&1)
for id in msn_coding_tdd msn_bugfix msn_no_skill_needed msn_interactive_grill; do
  if printf '%s\n' "$listing" | grep -q "  $id,admitted,"; then
    check "list-$id" PASS "admitted"
  else
    check "list-$id" FAIL "not admitted in list: $listing"
  fi
done

if printf '%s\n' "$("$UNVRS_BIN" mission show msn_coding_tdd --registry "$REGISTRY" 2>&1)" |
  grep -q '^outcome: '; then
  check show-brief PASS "outcome present"
else
  check show-brief FAIL "show printed no outcome"
fi

# bad-fixture-name → section the refusal must name
for pair in "bad-no-outcome:Outcome" "bad-no-done-check:Done check"; do
  name=${pair%%:*}
  section=${pair#*:}
  if out=$("$UNVRS_BIN" mission admit "$FIXTURES/bad/$name.md" --registry "$REGISTRY" 2>&1); then
    check "refuse-$name" FAIL "admitted a floor-failing mission: $out"
  elif printf '%s\n' "$out" | grep -qi "$section"; then
    check "refuse-$name" PASS "refused naming $section"
  else
    check "refuse-$name" FAIL "refused without naming $section: $out"
  fi
done

if [ "$(grep -c admitted "$REGISTRY")" -eq 4 ]; then
  check registry-rows PASS "4 admitted rows, no refused mission recorded"
else
  check registry-rows FAIL "unexpected registry contents: $(cat "$REGISTRY")"
fi

if git diff --quiet -- "$FIXTURES"; then
  check fixtures-pristine PASS "no write-back to fixtures"
else
  check fixtures-pristine FAIL "fixtures were modified"
fi

printf 'checks: journal %s\nfails: %s\n' "$JOURNAL" "$FAILS"
[ "$FAILS" -eq 0 ] || exit 1
echo "mission-admit-smoke: PASS"
