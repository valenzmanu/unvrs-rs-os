      "sensitive": false,
      "fields": {
        "harness": {
          "type": "enum",
          "explanation": "Choose the harness that runs this candidate. Example: codex.",
          "allowed": [
            "codex",
            "claude"
          ],
          "required": true
        },
        "model": {
          "type": "string",
          "explanation": "Use an exact catalog model ID or a newest-family selector. Example: newest sonnet.",
          "allowed": null,
          "required": true
        },
        "effort": {
          "type": "enum",
          "explanation": "Pin this candidate's effort instead of the task's usual effort. Light and deep use your class preferences; named efforts require exact harness support. A lower pin requires captain fallback. Example: low pins Sol to low effort.",
          "allowed": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "light",
            "deep"
          ],
          "required": false
        },
        "captain_fallback": {
          "type": "bool",
          "explanation": "Record the captain's permission to use this candidate below the task's reasoning level. The receipt and Crew card show the model and effort as captain fallback. Example: true permits the research Sol fallback at low effort.",
          "allowed": null,
          "required": false
