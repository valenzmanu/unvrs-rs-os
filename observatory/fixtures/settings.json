    {
      "key": "econ.profiles.judge",
      "section": "routing",
      "label": "Judge model choices",
      "explanation": "Try these candidates in order until a ready model supports the required effort. Example: try codex newest sol, then claude newest opus.",
      "type": "ordered-list",
      "default": [
        {
          "harness": "claude",
          "model": "newest opus"
